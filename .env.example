# Configuracion de la base de datos
DB_SERVER=host.docker.internal
DB_PORT=1433
DB_NAME=PHARMACYSYSTEMDB
DB_USER=Sa
DB_PASSWORD=

# Configuracion de JWT: reemplazar por una clave aleatoria unica de al menos 32 bytes.
JWT_SECRET=
JWT_ISSUER=https://api.FarmaDi.com
JWT_AUDIENCE=https://api.FarmaDi.com

# Credenciales para la interfaz local de Mongo Express.
MONGO_EXPRESS_USER=
MONGO_EXPRESS_PASSWORD=


